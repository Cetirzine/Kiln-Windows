<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Kiln.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Kiln.App" Title="Kiln">
    <Grid x:Name="Shell" Background="{ThemeResource KilnBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{ThemeResource KilnSidebar}" BorderBrush="{ThemeResource KilnStroke}" BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel x:Name="NavigationItems" Margin="0,52,0,0" Spacing="2" />
                <StackPanel x:Name="FooterItems" VerticalAlignment="Bottom" Margin="0,0,0,12" Spacing="2" />
            </Grid>
        </Border>
        <Grid x:Name="ContentRegion" Grid.Column="1">
            <Frame x:Name="RootFrame" />
            <Grid x:Name="DragRegion" Height="32" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Window>
