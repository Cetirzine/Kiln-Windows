                <VisualStateGroup x:Name="ScrollingIndicatorStates"><VisualState x:Name="NoIndicator"><VisualState.Setters><Setter Target="KilnScrollRoot.Opacity" Value="0" /></VisualState.Setters></VisualState><VisualState x:Name="TouchIndicator" /><VisualState x:Name="MouseIndicator" /><VisualState x:Name="MouseIndicatorFull" /></VisualStateGroup>
