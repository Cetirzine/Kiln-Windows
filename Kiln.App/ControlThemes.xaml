            <ScrollBar x:Name="HorizontalScrollBar" Grid.Row="1" Height="8" Orientation="Horizontal" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableWidth}" Value="{TemplateBinding HorizontalOffset}" ViewportSize="{TemplateBinding ViewportWidth}" />
            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource KilnPanelSecondary}" />
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuFlyoutSeparator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutSeparator"><Border Height="1" Background="{ThemeResource KilnStroke}" Margin="3,4" /></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ToolTip"><Setter Property="FontSize" Value="11.5" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{ThemeResource KilnPanel}" BorderBrush="{ThemeResource KilnEdge}" BorderThickness="1" Padding="8,5"><ContentPresenter Content="{TemplateBinding Content}" Foreground="{ThemeResource KilnText}" /></Border></ControlTemplate></Setter.Value></Setter></Style>
