<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Kiln.App">
    <!-- Keep native editing/selection behavior; all visible surfaces belong to Kiln. -->
    <Style x:Key="KilnTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" /><Setter Property="CornerRadius" Value="2" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="Background" Value="{ThemeResource KilnPanel}" /><Setter Property="BorderBrush" Value="{ThemeResource KilnEdge}" />
        <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="local:FieldMenus.Enabled" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Grid x:Name="FieldRoot">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="BorderElement.BorderBrush" Value="{ThemeResource KilnAccent}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="FieldRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
                <Border x:Name="BorderElement" Grid.Row="1" MinHeight="28" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                <ScrollViewer x:Name="ContentElement" Grid.Row="1" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsTabStop="False" ZoomMode="Disabled" />
                <TextBlock x:Name="PlaceholderTextContentPresenter" Grid.Row="1" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource KilnTextSecondary}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" />
                <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="11.5" Visibility="Collapsed" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="Background" Value="{ThemeResource KilnPanel}" /><Setter Property="BorderBrush" Value="{ThemeResource KilnEdge}" />
        <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="local:FieldMenus.Enabled" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
            <Grid x:Name="PasswordRoot">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" />
                        <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="BorderElement.BorderBrush" Value="{ThemeResource KilnAccent}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PasswordRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="ButtonStates"><VisualState x:Name="ButtonCollapsed" /><VisualState x:Name="ButtonVisible"><VisualState.Setters><Setter Target="RevealButton.Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="HeaderContentPresenter" Grid.ColumnSpan="2" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
                <Border x:Name="BorderElement" Grid.Row="1" Grid.ColumnSpan="2" MinHeight="28" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                <ScrollViewer x:Name="ContentElement" Grid.Row="1" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False" ZoomMode="Disabled" />
                <TextBlock x:Name="PlaceholderTextContentPresenter" Grid.Row="1" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource KilnTextSecondary}" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <ToggleButton x:Name="RevealButton" Grid.Row="1" Grid.Column="1" Width="28" Padding="0" IsTabStop="False" Visibility="Collapsed" Background="Transparent">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="RevealSurface" Background="{TemplateBinding Background}" Padding="4">
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Checked" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RevealSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed" /><VisualState x:Name="CheckedPointerOver" /><VisualState x:Name="CheckedPressed" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
                        <FontIcon Glyph="&#xE890;" FontSize="12" Foreground="{ThemeResource KilnTextSecondary}" />
                    </Border></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Grid.ColumnSpan="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="11.5" Visibility="Collapsed" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.5" /><Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="9,0,6,0" />
        <Setter Property="CornerRadius" Value="2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="Background" Value="{ThemeResource KilnPanel}" /><Setter Property="BorderBrush" Value="{ThemeResource KilnEdge}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid x:Name="ComboRoot">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Background.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ComboRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Background.BorderBrush" Value="{ThemeResource KilnAccent}" /></VisualState.Setters></VisualState><VisualState x:Name="FocusedPressed" /><VisualState x:Name="FocusedDropDown" /></VisualStateGroup>
                    <VisualStateGroup x:Name="DropDownStates"><VisualState x:Name="Opened" /><VisualState x:Name="Closed" /></VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="HeaderContentPresenter" Grid.ColumnSpan="2" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
                <Border x:Name="Background" Grid.Row="1" Grid.ColumnSpan="2" MinHeight="28" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                <ContentPresenter x:Name="ContentPresenter" Grid.Row="1" Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" Foreground="{ThemeResource KilnTextSecondary}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                </ContentPresenter>
                <FontIcon x:Name="DropDownGlyph" Grid.Row="1" Grid.Column="1" Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource KilnTextSecondary}" IsHitTestVisible="False" />
                <ContentPresenter x:Name="DescriptionPresenter" Grid.Row="2" Grid.ColumnSpan="2" Content="{TemplateBinding Description}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="11.5" Visibility="Collapsed" />
                <Popup x:Name="Popup"><Border x:Name="PopupBorder" Background="{ThemeResource KilnPanel}" BorderBrush="{ThemeResource KilnEdge}" BorderThickness="1.5" Padding="3" CornerRadius="2">
                    <ScrollViewer x:Name="ScrollViewer" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding TemplateSettings.DropDownContentMinWidth, RelativeSource={RelativeSource TemplatedParent}}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" IsTabStop="False" ZoomMode="Disabled"><ItemsPresenter /></ScrollViewer>
                </Border></Popup>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="9,4" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="Transparent" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="ItemSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed" />
                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="ItemSurface.Background" Value="{ThemeResource KilnHover}" /><Setter Target="ItemCheck.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="SelectedUnfocused"><VisualState.Setters><Setter Target="ItemCheck.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="ItemSurface.Background" Value="{ThemeResource KilnHover}" /><Setter Target="ItemCheck.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="ItemCheck.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ItemSurface.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
            </VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            <FontIcon x:Name="ItemCheck" Grid.Column="1" Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource KilnAccent}" Opacity="0" />
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnSpinnerButton" TargetType="RepeatButton">
        <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Foreground" Value="{ThemeResource KilnTextSecondary}" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border x:Name="SpinSurface" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SpinSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SpinSurface.Background" Value="{ThemeResource KilnPanelSecondary}" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SpinSurface.Opacity" Value="0.35" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="8,0" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource KilnPanel}" /><Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="BorderBrush" Value="{ThemeResource KilnEdge}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="NumberBox"><Grid x:Name="NumberRoot">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="NumberRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="SpinButtonStates"><VisualState x:Name="SpinButtonsCollapsed" /><VisualState x:Name="SpinButtonsVisible"><VisualState.Setters><Setter Target="SpinColumn.Visibility" Value="Visible" /></VisualState.Setters></VisualState><VisualState x:Name="SpinButtonsPopup"><VisualState.Setters><Setter Target="SpinColumn.Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="UpSpinButtonEnabledStates"><VisualState x:Name="UpSpinButtonEnabled" /><VisualState x:Name="UpSpinButtonDisabled"><VisualState.Setters><Setter Target="UpSpinButton.IsEnabled" Value="False" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="DownSpinButtonEnabledStates"><VisualState x:Name="DownSpinButtonEnabled" /><VisualState x:Name="DownSpinButtonDisabled"><VisualState.Setters><Setter Target="DownSpinButton.IsEnabled" Value="False" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="HeaderContentPresenter" Grid.ColumnSpan="2" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <TextBox x:Name="InputBox" Grid.Row="1" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" BorderThickness="0" Background="Transparent" InputScope="{TemplateBinding InputScope}" PlaceholderText="{TemplateBinding PlaceholderText}" TextAlignment="{TemplateBinding TextAlignment}" />
            <Grid x:Name="SpinColumn" Grid.Row="1" Grid.Column="1" Width="22" Margin="0,1,1,1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <RepeatButton x:Name="UpSpinButton" Style="{StaticResource KilnSpinnerButton}" IsTabStop="False"><FontIcon Glyph="&#xE70E;" FontSize="7" /></RepeatButton>
                <RepeatButton x:Name="DownSpinButton" Grid.Row="1" Style="{StaticResource KilnSpinnerButton}" IsTabStop="False"><FontIcon Glyph="&#xE70D;" FontSize="7" /></RepeatButton>
            </Grid>
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnSliderThumb" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="SliderThumbSurface" Background="{ThemeResource KilnPanel}" BorderBrush="{ThemeResource KilnEdge}" BorderThickness="1" CornerRadius="2">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="SliderThumbSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="SliderThumbSurface.BorderBrush" Value="{ThemeResource KilnAccent}" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled" /></VisualStateGroup></VisualStateManager.VisualStateGroups>
        </Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="28" /><Setter Property="Foreground" Value="{ThemeResource KilnAccent}" /><Setter Property="Background" Value="{ThemeResource KilnStroke}" /><Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid x:Name="SliderRoot">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="SliderRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="SliderFocus.Opacity" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="HeaderContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{ThemeResource KilnTextSecondary}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
            <Grid x:Name="SliderContainer" Grid.Row="1" Background="Transparent">
                <Grid x:Name="HorizontalTemplate" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="3" Fill="{TemplateBinding Background}" />
                    <Rectangle x:Name="HorizontalDecreaseRect" Height="3" Fill="{TemplateBinding Foreground}" />
                    <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="12" Height="16" Style="{StaticResource KilnSliderThumb}" DataContext="{TemplateBinding Value}" />
                </Grid>
                <Grid x:Name="VerticalTemplate" MinWidth="28" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="3" Fill="{TemplateBinding Background}" />
                    <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="3" Fill="{TemplateBinding Foreground}" />
                    <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="16" Height="12" Style="{StaticResource KilnSliderThumb}" DataContext="{TemplateBinding Value}" />
                </Grid>
            </Grid>
            <Border x:Name="SliderFocus" Grid.Row="1" BorderBrush="{ThemeResource KilnAccent}" BorderThickness="1" CornerRadius="2" Opacity="0" IsHitTestVisible="False" />
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource KilnPanel}" /><Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="BorderBrush" Value="{ThemeResource KilnEdge}" /><Setter Property="BorderThickness" Value="1.5" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Padding" Value="4" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutPresenter"><Grid>
            <Border Background="{ThemeResource KilnHardShadow}" Margin="3,3,-3,-3" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="MenuFlyoutPresenterScrollViewer" Margin="{TemplateBinding Padding}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" MinWidth="{Binding TemplateSettings.FlyoutContentMinWidth, RelativeSource={RelativeSource TemplatedParent}}"><ItemsPresenter /></ScrollViewer></Border>
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnMenuItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Padding" Value="10,4" /><Setter Property="Foreground" Value="{ThemeResource KilnText}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuFlyoutItem"><Grid x:Name="MenuSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="MenuSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="MenuSurface.Background" Value="{ThemeResource KilnPanelSecondary}" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="MenuSurface.Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="CheckPlaceholderStates"><VisualState x:Name="NoPlaceholder" /><VisualState x:Name="CheckPlaceholder"><VisualState.Setters><Setter Target="MenuText.Margin" Value="24,0,0,0" /></VisualState.Setters></VisualState><VisualState x:Name="IconPlaceholder"><VisualState.Setters><Setter Target="MenuText.Margin" Value="24,0,0,0" /><Setter Target="IconRoot.Visibility" Value="Visible" /></VisualState.Setters></VisualState><VisualState x:Name="CheckAndIconPlaceholder"><VisualState.Setters><Setter Target="MenuText.Margin" Value="48,0,0,0" /><Setter Target="IconRoot.Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
                <VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility"><VisualState x:Name="KeyboardAcceleratorTextCollapsed" /><VisualState x:Name="KeyboardAcceleratorTextVisible"><VisualState.Setters><Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" /></VisualState.Setters></VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Viewbox x:Name="IconRoot" Width="16" Height="16" HorizontalAlignment="Left" Visibility="Collapsed"><ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" /></Viewbox>
            <TextBlock x:Name="MenuText" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="KeyboardAcceleratorTextBlock" Grid.Column="1" Text="{TemplateBinding KeyboardAcceleratorTextOverride}" FontSize="11" Foreground="{ThemeResource KilnTextSecondary}" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{ThemeResource KilnTextSecondary}" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="IconButtonSurface" Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent">
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="IconButtonSurface.Background" Value="{ThemeResource KilnHover}" /></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="IconButtonSurface.Background" Value="{ThemeResource KilnPanelSecondary}" /></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="IconButtonSurface.Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup><VisualStateGroup x:Name="FocusStates"><VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" /><VisualState x:Name="Focused"><VisualState.Setters><Setter Target="IconButtonSurface.BorderBrush" Value="{ThemeResource KilnAccent}" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="4" /><Setter Property="Height" Value="4" /><Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource KilnAccent}" /><Setter Property="Background" Value="{ThemeResource KilnPanelSecondary}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="LayoutRoot">
                <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Determinate" /><VisualState x:Name="Updating" />
                    <VisualState x:Name="Error"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Fill" Value="{ThemeResource KilnRed}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="UpdatingError"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Fill" Value="{ThemeResource KilnRed}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Paused"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Fill" Value="{ThemeResource KilnYellow}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Indeterminate"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator.Opacity" Value="1" /></VisualState.Setters><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="IndeterminateShift" Storyboard.TargetProperty="TranslateX" From="{Binding TemplateSettings.ContainerAnimationStartPosition, RelativeSource={RelativeSource TemplatedParent}}" To="{Binding TemplateSettings.ContainerAnimationEndPosition, RelativeSource={RelativeSource TemplatedParent}}" Duration="0:0:1.5" /></Storyboard></VisualState>
                    <VisualState x:Name="IndeterminateError"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator.Opacity" Value="1" /><Setter Target="IndeterminateProgressBarIndicator.Fill" Value="{ThemeResource KilnRed}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="IndeterminatePaused"><VisualState.Setters><Setter Target="DeterminateProgressBarIndicator.Opacity" Value="0" /><Setter Target="IndeterminateProgressBarIndicator.Opacity" Value="1" /><Setter Target="IndeterminateProgressBarIndicator.Fill" Value="{ThemeResource KilnYellow}" /></VisualState.Setters></VisualState>
                </VisualStateGroup></VisualStateManager.VisualStateGroups>
                <Border x:Name="ProgressBarRoot" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Border Clip="{Binding TemplateSettings.ClipRect, RelativeSource={RelativeSource TemplatedParent}}"><Grid>
                    <Rectangle x:Name="ProgressBarTrack" Fill="{TemplateBinding Background}" />
                    <Rectangle x:Name="DeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    <Rectangle x:Name="IndeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Opacity="0"><Rectangle.RenderTransform><CompositeTransform x:Name="IndeterminateShift" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle x:Name="IndeterminateProgressBarIndicator2" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Opacity="0"><Rectangle.RenderTransform><CompositeTransform /></Rectangle.RenderTransform></Rectangle>
                </Grid></Border></Border>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="KilnScrollPageButton" TargetType="RepeatButton">
