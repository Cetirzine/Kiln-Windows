                <VisualState x:Name="TouchIndicator"><VisualState.Setters><Setter Target="VerticalScrollBar.IndicatorMode" Value="TouchIndicator" /><Setter Target="HorizontalScrollBar.IndicatorMode" Value="TouchIndicator" /></VisualState.Setters></VisualState>
