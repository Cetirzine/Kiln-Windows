                <RepeatButton x:Name="VerticalLargeDecrease" Grid.Row="1" Height="0" Style="{StaticResource KilnScrollPageButton}" />
                <Thumb x:Name="VerticalThumb" Grid.Row="2" MinHeight="24" Width="6" Style="{StaticResource KilnScrollThumb}" />
                <RepeatButton x:Name="VerticalLargeIncrease" Grid.Row="3" Style="{StaticResource KilnScrollPageButton}" />
                <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Height="0" Style="{StaticResource KilnScrollPageButton}" />
            </Grid>
        </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="ZoomMode" Value="Disabled" />
